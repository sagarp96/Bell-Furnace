---
import FurnaceScene from "../components/FurnaceScene.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const products = [
	{
		img: "bell-annealing-furnace-loading.jpg",
		drg: "BFE-01",
		title: "Bell Type Annealing Furnace",
		body: "Flagship batch annealing systems for wire coils & strip — uniform results, charge after charge.",
		alt: "Bell type annealing furnace being loaded over wire coils",
	},
	{
		img: "retort-lifting.jpg",
		drg: "BFE-02",
		title: "Retorts / Inner Covers",
		body: "Corrugated heat-resistant inner covers for gas-tight, controlled-atmosphere annealing.",
		alt: "Corrugated retort being lifted by crane",
	},
	{
		img: "impeller-dynamic-balancing.jpg",
		drg: "BFE-03",
		title: "Impellers & Diffusers",
		body: "Cast & fabricated circulation fans, dynamically balanced for high-velocity uniform heating.",
		alt: "Fabricated high-velocity impeller",
	},
	{
		img: "heating-hood.jpg",
		drg: "BFE-04",
		title: "Heating Hoods",
		body: "Insulated electric / gas-fired hoods engineered for low heat loss and long element life.",
		alt: "Insulated heating hood with wiring panels",
	},
	{
		img: "base-assembly-dispatch.jpg",
		drg: "BFE-05",
		title: "Base Assemblies",
		body: "Complete furnace bases with drive, sealing and diffuser systems, ready for installation.",
		alt: "Furnace base assembly loaded for dispatch",
	},
	{
		img: "charge-baskets.jpg",
		drg: "BFE-06",
		title: "Charge Carriers",
		body: "Baskets, convector plates and lifting tackle built to survive repeated thermal cycling.",
		alt: "Perforated charge carrier baskets",
	},
];

const why = [
	[
		"01",
		"Custom capacities on demand",
		"6T/7.5T/10.5T/15T/18T/30T and Spare parts",
	],
	[
		"02",
		"Methanol/Vacuum based",
		"Decarb control through unique Hydro-carbon liquid purging/Vacuumization systems.",
	],

	["03", "Automated Workflow", "Complete Auto Operation through PLC and SCADA"],
	[
		"04",
		"A 39-year furnace lineage",
		"Built on the experience of Industrial Engineers (est. 1987) — hundreds of heat-processing installations across India",
	],
];

const industries = [
	"WIRE & CABLE",
	"STRIP & SHEET",
	"AUTOMOTIVE",
	"BEARING INDUSTRY",
	"FASTENR INDUSTRY",
	"COPPER & ALUMINIUM",
];

const process = [
	[
		"01",
		"Requirement & Thermal Design",
		"Charge weight, material, cycle and atmosphere — engineered into a custom furnace design.",
	],
	[
		"02",
		"In-house Manufacture",
		"Hoods, retorts, bases, impellers and carriers fabricated at our Mundka works, New Delhi.",
	],
	[
		"03",
		"Erection & Commissioning",
		"Site installation, trials and handover with proven cycle results at your plant.",
	],
	[
		"04",
		"Spares & Lifetime Support",
		"Retorts, impellers, elements and carriers as spares — plus retrofits for older furnaces.",
	],
];
---

<BaseLayout
	title="Bell Furnace Engineers — Bell Type Annealing Furnaces"
	description="ISO 9001:2015 certified manufacturer of bell type annealing furnaces, retorts, impellers, base assemblies and charge carriers for the wire & strip industry."
>
	<!-- HERO -->
	<div style="position:relative;overflow:hidden;background:#ffffff">
		<div style="display:flex;flex-wrap:wrap;gap:clamp(24px,4vw,56px);align-items:center;padding:clamp(32px,5vw,72px) clamp(16px,4vw,44px) clamp(28px,4vw,56px);max-width:1440px;margin:0 auto">
			<div style="flex:1.05;min-width:min(320px,100%)">
				<div style="display:inline-flex;align-items:center;gap:10px;border:1px solid #D91E26;color:#D91E26;font-size:clamp(10px,1.3vw,12.5px);letter-spacing:3px;font-weight:600;padding:7px 14px;margin-bottom:22px">
					<span style="width:8px;height:8px;background:#D91E26;border-radius:50%"></span>
					ISO 9001:2015 CERTIFIED MANUFACTURER
				</div>
				<h1 style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(32px,5vw,58px);line-height:1.06;margin:0;color:#141419;text-wrap:pretty">Bell Type Annealing Furnaces,<br /><span style="color:#D91E26;font-style:italic">Built for Consistent Results.</span></h1>
				<p style="font-size:clamp(15px,1.6vw,17.5px);line-height:1.7;color:#555;margin:20px 0 0;max-width:540px;text-wrap:pretty">Design, manufacture, erection &amp; commissioning of bell annealing furnaces and heat-processing equipment for the wire &amp; strip industry — ferrous and non-ferrous. Backed by a 39-year legacy through our sister concern, Industrial Engineers.</p>
				<div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:30px">
					<a class="btn-red" href="/products" style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:15px;background:#D91E26;color:#fff;padding:15px 30px;letter-spacing:1.5px;cursor:pointer;text-decoration:none">EXPLORE PRODUCTS</a>
					<a class="btn-outline-dark" href="/contact" style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:15px;border:2px solid #141419;color:#141419;padding:13px 30px;letter-spacing:1.5px;cursor:pointer;text-decoration:none">GET A QUOTE</a>
				</div>
			</div>

			<!-- 3D ANNEALING CYCLE -->
			<div style="flex:.95;min-width:min(320px,100%);display:flex;flex-direction:column;gap:8px">
				<FurnaceScene />
				<div style="font-size:11.5px;color:#9a9a9a;letter-spacing:.5px">*Indicative cycle — furnace customised to each charge weight &amp; coil size.</div>
			</div>
		</div>
	</div>

	<!-- STATS -->
	<div style="background:#0c0c0c;position:relative;overflow:hidden">
		<img src="/assets/bfe-logo.png" alt="" style="position:absolute;right:-40px;top:50%;transform:translateY(-50%);height:220%;opacity:.06;pointer-events:none" />
		<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:28px;padding:clamp(28px,4vw,44px) clamp(16px,4vw,44px);max-width:1440px;margin:0 auto;position:relative">
			<div data-reveal style="opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s">
				<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(28px,3.4vw,38px);color:#FF3B42"><span data-count="39" data-suffix="+">39+</span></div>
				<div style="font-size:12.5px;letter-spacing:2px;color:#bbb;margin-top:4px">YEARS OF COMBINED LEGACY</div>
			</div>
			<div data-reveal data-delay="80" style="opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s">
				<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(28px,3.4vw,38px);color:#FF3B42"><span data-count="1987">1987</span></div>
				<div style="font-size:12.5px;letter-spacing:2px;color:#bbb;margin-top:4px">INDUSTRIAL ENGINEERS EST.</div>
			</div>
			<div data-reveal data-delay="160" style="opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s">
				<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(28px,3.4vw,38px);color:#FF3B42"><span data-count="2" data-suffix="">2</span> UNITS</div>
				<div style="font-size:12.5px;letter-spacing:2px;color:#bbb;margin-top:4px">OFFICE + WORKS, DELHI NCR</div>
			</div>
			<div data-reveal data-delay="240" style="opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s">
				<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(28px,3.4vw,38px);color:#FF3B42">ISO 9001</div>
				<div style="font-size:12.5px;letter-spacing:2px;color:#bbb;margin-top:4px">2015 CERTIFIED QUALITY</div>
			</div>
		</div>
	</div>

	<!-- PRODUCTS GRID -->
	<div style="background:#f8f6f3;padding:clamp(40px,6vw,72px) clamp(16px,4vw,44px)">
		<div style="max-width:1440px;margin:0 auto">
			<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:34px">
				<div>
					<div style="font-size:12.5px;letter-spacing:4px;color:#D91E26;font-weight:600">WHAT WE BUILD</div>
					<h2 style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(26px,3.6vw,40px);margin:8px 0 0;color:#141419">The Complete Bell Furnace System</h2>
				</div>
				<a class="link-red" href="/products" style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:14px;color:#D91E26;letter-spacing:1.5px;cursor:pointer;border-bottom:2px solid #D91E26;padding-bottom:3px;text-decoration:none">ALL PRODUCTS →</a>
			</div>
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:22px">
				{products.map((p, i) => (
					<a class="product-card" href="/products" data-reveal data-delay={(i % 3) * 80} style="opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s;background:#fff;border:1px solid #ececec;cursor:pointer;text-decoration:none;color:inherit;display:block">
						<div style="position:relative;aspect-ratio:3/4;overflow:hidden">
							<img src={`/assets/${p.img}`} alt={p.alt} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
							<div data-bpwipe style="position:absolute;inset:0;background:#ffffff;isolation:isolate;clip-path:inset(0 0 0 0);transition:clip-path 1.2s cubic-bezier(.65,0,.35,1)">
								<img src={`/assets/${p.img}`} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.5) brightness(1.12);mix-blend-mode:multiply" />
								<div style="position:absolute;inset:0;background:#D91E26;mix-blend-mode:lighten"></div>
								<div style="position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.16) 0 1px,transparent 1px 26px),repeating-linear-gradient(90deg,rgba(255,255,255,.16) 0 1px,transparent 1px 26px)"></div>
								<div style="position:absolute;left:10px;bottom:8px;font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:10px;letter-spacing:2px;color:#fff;background:rgba(0,0,0,.28);padding:3px 8px">DRG · {p.drg}</div>
							</div>
						</div>
						<div style="padding:22px">
							<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:19px;color:#141419">{p.title}</div>
							<div style="font-size:14px;line-height:1.6;color:#666;margin-top:8px">{p.body}</div>
							<div style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:12.5px;color:#D91E26;letter-spacing:1.5px;margin-top:14px">READ MORE →</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</div>

	<!-- WHY BFE -->
	<div style="padding:clamp(40px,6vw,72px) clamp(16px,4vw,44px);background:#fff">
		<div style="display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,56px);align-items:center;max-width:1440px;margin:0 auto">
			<div data-reveal style="opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s;flex:1;min-width:min(320px,100%)">
				<img src="/assets/plant-installation.jpg" alt="Bell annealing furnaces commissioned at customer plant" style="width:100%;height:clamp(280px,32vw,420px);object-fit:cover;display:block;border:1px solid #ececec" />
			</div>
			<div style="flex:1;min-width:min(320px,100%)">
				<div style="font-size:12.5px;letter-spacing:4px;color:#D91E26;font-weight:600">WHY BELL FURNACE ENGINEERS</div>
				<h2 style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(26px,3.6vw,40px);margin:8px 0 0;color:#141419;text-wrap:pretty">FEATURES THAT STANDS US OUT</h2>
				<div style="display:flex;flex-direction:column;gap:18px;margin-top:26px">
					{why.map(([n, t, b], i) => (
						<div data-reveal data-delay={i * 80} style="opacity:0;transform:translateY(18px);transition:opacity .7s,transform .7s;display:flex;gap:16px">
							<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;color:#D91E26;font-size:18px;flex:none">{n}</div>
							<div><div style="font-weight:600;font-size:16px">{t}</div><div style="font-size:14px;color:#666;line-height:1.6;margin-top:2px">{b}</div></div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>

	<!-- INDUSTRIES -->
	<div style="background:#D91E26;padding:clamp(32px,5vw,52px) clamp(16px,4vw,44px);position:relative;overflow:hidden">
		<img src="/assets/bfe-logo.png" alt="" style="position:absolute;left:-30px;bottom:-80px;height:260px;opacity:.10;pointer-events:none" />
		<div style="max-width:1440px;margin:0 auto;position:relative">
			<div style="font-size:12.5px;letter-spacing:4px;color:rgba(255,255,255,.85);font-weight:600">INDUSTRIES WE SERVE</div>
			<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:18px">
				{industries.map((ind) => (
					<div style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:clamp(13px,1.5vw,15px);letter-spacing:1.5px;color:#fff;border:1.5px solid rgba(255,255,255,.7);padding:10px 20px">{ind}</div>
				))}
			</div>
		</div>
	</div>

	<!-- PROCESS -->
	<div style="padding:clamp(40px,6vw,72px) clamp(16px,4vw,44px);background:#fff">
		<div style="max-width:1440px;margin:0 auto">
			<div style="font-size:12.5px;letter-spacing:4px;color:#D91E26;font-weight:600">HOW WE WORK</div>
			<h2 style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(26px,3.6vw,40px);margin:8px 0 30px;color:#141419">Four steps to a running furnace</h2>
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr));gap:22px">
				{process.map(([n, t, b], i) => (
					<div data-reveal data-delay={i * 80} style="opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s;border-top:3px solid #D91E26;padding:20px 4px 0">
						<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:30px;color:#D91E26">{n}</div>
						<div style="font-weight:600;font-size:17px;margin-top:6px">{t}</div>
						<div style="font-size:14px;color:#666;line-height:1.6;margin-top:6px">{b}</div>
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- CTA -->
	<div style="background:#0c0c0c;padding:clamp(36px,5vw,60px) clamp(16px,4vw,44px)">
		<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:20px;max-width:1440px;margin:0 auto">
			<div>
				<div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:clamp(22px,3vw,32px);color:#fff">Planning a new annealing line?</div>
				<div style="font-size:15px;color:#aaa;margin-top:6px">Send us your charge details — we'll respond with a proposal.</div>
			</div>
			<div style="display:flex;flex-wrap:wrap;gap:14px">
				<a class="btn-red" href="/contact" style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:15px;background:#D91E26;color:#fff;padding:15px 30px;letter-spacing:1.5px;cursor:pointer;text-decoration:none">GET A QUOTE</a>
				<a class="btn-outline-white" href="https://wa.me/919810630056" style="font-family:'Chakra Petch',sans-serif;font-weight:600;font-size:15px;border:2px solid #fff;color:#fff;padding:13px 30px;letter-spacing:1.5px;cursor:pointer;text-decoration:none">WHATSAPP US</a>
			</div>
		</div>
	</div>
</BaseLayout>
