---
const navItems = [
	{ href: "/", label: "Home" },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
];
---

<header class="site-header">
	<a class="site-header__brand" href="/">Bell Furnace</a>

	<!-- Mobile nav: <details>/<summary> disclosure, zero JS, keyboard/screen-reader
	     operable by default. This is the plan's one deliberate exception to
	     "all interactivity is a React island" — a native HTML element needs none. -->
	<details class="site-header__mobile-nav">
		<summary aria-label="Toggle navigation">Menu</summary>
		<ul class="site-header__nav-list">
			{navItems.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
	</details>

	<nav class="site-header__desktop-nav" aria-label="Primary">
		<ul class="site-header__nav-list">
			{navItems.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--space-sm) var(--space-md);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__brand {
		font-weight: 700;
		font-size: var(--font-size-lg);
	}

	.site-header__nav-list {
		list-style: none;
		display: flex;
		gap: var(--space-md);
		margin: 0;
		padding: 0;
	}

	.site-header__desktop-nav {
		display: none;
	}

	.site-header__mobile-nav summary {
		cursor: pointer;
		min-height: var(--tap-target-min);
		display: flex;
		align-items: center;
		list-style: none;
	}

	.site-header__mobile-nav summary::-webkit-details-marker {
		display: none;
	}

	.site-header__mobile-nav[open] .site-header__nav-list {
		flex-direction: column;
		position: absolute;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		padding: var(--space-sm);
		right: var(--space-md);
	}

	@media (min-width: 600px) {
		.site-header__mobile-nav {
			display: none;
		}

		.site-header__desktop-nav {
			display: block;
		}
	}
</style>
